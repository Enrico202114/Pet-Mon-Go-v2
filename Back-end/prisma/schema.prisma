generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model tutor {
  idtutor    Int      @id @default(autoincrement())
  nometutor  String   @db.VarChar(160)
  emailtutor String   @unique @db.VarChar(254)
  senhatutor String   @db.VarChar(255)
  familias   FamiliaMembro[]
  pets       pet[]
}

model familia {
  idfamilia        Int             @id @default(autoincrement())
  nomefamilia      String          @db.VarChar(160)
  codigofamilia    String          @unique @db.VarChar(12)
  privada          Boolean         @default(false)
  datacriacao      DateTime        @default(now()) @db.Timestamp(3)
  membros          FamiliaMembro[]
}

model FamiliaMembro {
  idfamilia Int
  idtutor   Int
  papel     String   @default("membro") @db.VarChar(30)
  familia   familia  @relation(fields: [idfamilia], references: [idfamilia], onDelete: Cascade)
  tutor     tutor    @relation(fields: [idtutor], references: [idtutor], onDelete: Cascade)

  @@id([idfamilia, idtutor])
  @@index([idtutor])
}

model pet {
  idpet       Int      @id @default(autoincrement())
  idtutor     Int
  nomepet     String   @db.VarChar(120)
  especiespet String   @db.VarChar(60)
  racapet     String?  @db.VarChar(120)
  sexopet     String?  @db.VarChar(20)
  datanascpet DateTime? @db.Date
  pesopet     Decimal? @db.Decimal(7, 2)
  tutor       tutor    @relation(fields: [idtutor], references: [idtutor], onDelete: Cascade)
  alimentacoes alimentacao[]
  medicacoes   medicacao[]
  vacinas      vacina[]
  passeios     passeio[]

  @@index([idtutor])
}

model alimentacao {
  idalimentacao         Int      @id @default(autoincrement())
  idpet                 Int
  tipoalimentacao       String   @db.VarChar(120)
  quantidadealimentacao Decimal? @db.Decimal(8, 2)
  unidadequantidade     String?  @db.VarChar(30)
  observacao            String?  @db.Text
  pet                   pet      @relation(fields: [idpet], references: [idpet], onDelete: Cascade)

  @@index([idpet])
}

model medicacao {
  idmedicacao           Int      @id @default(autoincrement())
  idpet                 Int
  nomemedicacao         String   @db.VarChar(160)
  dosagemmedicamento    String?  @db.VarChar(80)
  frequenciamedicamento Int?
  tipofrequencia        String?  @db.VarChar(40)
  datainicio            DateTime? @db.Date
  datafim               DateTime? @db.Date
  observacao            String?  @db.Text
  pet                   pet      @relation(fields: [idpet], references: [idpet], onDelete: Cascade)

  @@index([idpet])
}

model vacina {
  idvacina      Int      @id @default(autoincrement())
  idpet         Int
  nomevacina    String   @db.VarChar(160)
  lotevacina    String?  @db.VarChar(80)
  dataaplicacao DateTime @db.Date
  proximadose   DateTime? @db.Date
  observacao    String?  @db.Text
  pet           pet      @relation(fields: [idpet], references: [idpet], onDelete: Cascade)

  @@index([idpet])
  @@index([proximadose])
}

model passeio {
  idpasseio   Int      @id @default(autoincrement())
  idpet       Int
  datahora    DateTime
  duracaoMinutos Int
  local       String?  @db.VarChar(160)
  observacao  String?  @db.Text
  pet         pet      @relation(fields: [idpet], references: [idpet], onDelete: Cascade)

  @@index([idpet, datahora])
}
